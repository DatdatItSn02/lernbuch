{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernbuch.local/schema/lernbuch-import-v1.json",
  "title": "File nhập nội dung Lernbuch, phiên bản 1",
  "description": "Claude tạo file này từ sách, PDF hoặc ghi chú; trang quản trị kiểm tra rồi nhập. Khoá (key) ổn định để nhập lại không mất tiến độ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "language", "course", "source", "generated_by"],
  "properties": {
    "format": {"const": "lernbuch-import"},
    "version": {"const": 1},
    "language": {"enum": ["de"]},
    "course": {"type": "string", "pattern": "^[a-z0-9-]{3,40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "kind", "license"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9-]{3,40}$"},
        "title": {"type": "string", "minLength": 2, "maxLength": 200},
        "kind": {"enum": ["book", "pdf", "web", "own", "ai"]},
        "author": {"type": "string", "maxLength": 200},
        "publisher": {"type": "string", "maxLength": 200},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "license": {"enum": ["allowed", "licensed", "forbidden", "unknown"]},
        "license_note": {"type": "string", "maxLength": 500},
        "pages": {"type": "string", "maxLength": 60}
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "date"],
      "properties": {
        "tool": {"type": "string", "maxLength": 40},
        "model": {"type": "string", "maxLength": 60},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "topics": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/topic"}},
    "cards": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/card"}},
    "grammar": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/grammar"}},
    "exercises": {"type": "array", "maxItems": 3000, "items": {"$ref": "#/$defs/exercise"}},
    "verbs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/verb"}}
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "ref": {"type": "string", "pattern": "^@?[a-z0-9][a-z0-9-]{2,63}$", "description": "khoá trong file, hoặc @mã của mục đã có trên web"},
    "level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "origin": {"enum": ["written", "fact", "source"], "description": "written = viết mới; fact = dữ kiện từ điển; source = chép nguyên từ nguồn"},
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "vi", "origin"],
      "properties": {
        "de": {"type": "string", "minLength": 2, "maxLength": 200},
        "vi": {"type": "string", "minLength": 1, "maxLength": 250},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title_vi", "level"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "title_vi": {"type": "string", "minLength": 1, "maxLength": 120},
        "title_de": {"type": "string", "maxLength": 120},
        "level": {"$ref": "#/$defs/level"}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "topic", "collection", "level", "front", "meanings", "examples"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "topic": {"$ref": "#/$defs/ref"},
        "collection": {"enum": ["vocab", "phrase", "comm", "pattern", "verbprep", "sepverb", "name"]},
        "level": {"$ref": "#/$defs/level"},
        "front": {"type": "string", "minLength": 1, "maxLength": 160},
        "lemma": {"type": "string", "maxLength": 80},
        "pos": {"enum": ["noun", "verb", "adj", "adv", "prep", "conj", "pron", "num", "phrase", "other"]},
        "gender": {"enum": ["m", "f", "n", "pl"]},
        "plural": {"type": "string", "maxLength": 80},
        "forms": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 80}},
        "meanings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vi"],
          "properties": {
            "vi": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
            "en": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
          }
        },
        "examples": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/example"}},
        "note_vi": {"type": "string", "maxLength": 300},
        "tags": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[a-z0-9-]{2,30}$"}},
        "source_ref": {"type": "string", "maxLength": 60},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "block": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "md"],
         "properties": {"type": {"const": "text"}, "md": {"type": "string", "minLength": 1, "maxLength": 2000}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "de", "vi"],
         "properties": {"type": {"const": "example"}, "de": {"type": "string", "maxLength": 200}, "vi": {"type": "string", "maxLength": 250}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "rows"],
         "properties": {"type": {"const": "table"},
                        "rows": {"type": "array", "minItems": 2, "maxItems": 30,
                                 "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "maxLength": 80}}}}}
      ]
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "chapter", "level", "title_vi", "blocks"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "chapter": {"type": "string", "minLength": 1, "maxLength": 120},
        "level": {"$ref": "#/$defs/level"},
        "title_vi": {"type": "string", "minLength": 1, "maxLength": 160},
        "blocks": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/block"}},
        "source_ref": {"type": "string", "maxLength": 60},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "set", "type", "level", "prompt", "answers", "origin"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "set": {"$ref": "#/$defs/key"},
        "type": {"enum": ["choice", "gap", "order", "translate"]},
        "level": {"$ref": "#/$defs/level"},
        "prompt": {"type": "string", "minLength": 2, "maxLength": 300},
        "answers": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "choices": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "explain_vi": {"type": "string", "maxLength": 400},
        "grammar": {"$ref": "#/$defs/ref"},
        "source_ref": {"type": "string", "maxLength": 60},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["infinitive", "level", "meanings_vi", "conjugation"],
      "properties": {
        "infinitive": {"type": "string", "pattern": "^[a-zäöüß-]{2,40}$"},
        "level": {"$ref": "#/$defs/level"},
        "meanings_vi": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 80}},
        "conjugation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["praesens", "perfekt", "praeteritum"],
          "properties": {
            "praesens": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ich", "du", "er", "wir", "ihr", "sie"],
              "properties": {
                "ich": {"type": "string"}, "du": {"type": "string"}, "er": {"type": "string"},
                "wir": {"type": "string"}, "ihr": {"type": "string"}, "sie": {"type": "string"}
              }
            },
            "perfekt": {"type": "string", "maxLength": 60},
            "praeteritum": {"type": "string", "maxLength": 60}
          }
        }
      }
    }
  }
}
