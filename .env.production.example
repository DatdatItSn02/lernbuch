# Mẫu .env cho alwaysdata. Workflow deploy điền __DB_PASSWORD__ từ GitHub Secrets,
# máy chủ giữ nguyên APP_KEY đã sinh ở lần deploy đầu. Không ghi bí mật vào file này.
APP_NAME=Lernbuch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lernbuch.alwaysdata.net

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_HOST=mysql-lernbuch.alwaysdata.net
DB_PORT=3306
DB_DATABASE=lernbuch_app
DB_USERNAME=lernbuch_app
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
