# Mẫu .env cho alwaysdata. Workflow deploy điền __DB_PASSWORD__, __MAIL_PASSWORD__ từ GitHub Secrets,
# máy chủ giữ nguyên APP_KEY đã sinh ở lần deploy đầu. Không ghi bí mật vào file này.
APP_NAME=Lernbuch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Chế độ xem thử (tạm thời): app học mở không cần đăng nhập, các trang đăng nhập tắt. Tắt: đổi thành false rồi deploy
XEM_THU=true
APP_URL=https://lernbuch.alwaysdata.net

APP_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_HOST=mysql-lernbuch.alwaysdata.net
DB_PORT=3306
DB_DATABASE=lernbuch_app
DB_USERNAME=lernbuch_app
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Gửi qua hộp thư có sẵn của tài khoản alwaysdata (docs/huong-dan-alwaysdata.md, mục 5)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp-lernbuch.alwaysdata.net
MAIL_PORT=465
MAIL_USERNAME=lernbuch@alwaysdata.net
MAIL_PASSWORD=__MAIL_PASSWORD__
MAIL_FROM_ADDRESS=lernbuch@alwaysdata.net
MAIL_FROM_NAME=Lernbuch

# Khoá Gemini cho AI (G2): workflow deploy điền từ secret GEMINI_API_KEY. Thiếu khoá thì AI báo lỗi cấu hình; AI tắt sẵn ở trang Cài đặt AI.
GEMINI_API_KEY=__GEMINI_API_KEY__
